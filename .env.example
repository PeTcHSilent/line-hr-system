# ============================================
# LINE Messaging API
# ============================================
# จาก LINE Developers Console > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ============================================
# Database (PostgreSQL)
# ============================================
# Local: postgresql://user:password@localhost:5432/hr_db
# Production (Railway/Supabase): ใช้ Connection String จาก dashboard
DATABASE_URL=postgresql://postgres:password@localhost:5432/hr_db

# ============================================
# LIFF App
# ============================================
# จาก LINE Developers Console > LIFF > Add (สร้าง LIFF app แยกสำหรับแต่ละ endpoint)
LIFF_ID=your_liff_id_for_leave            # endpoint: /liff/leave
LIFF_ID_OT=your_liff_id_for_ot           # endpoint: /liff/ot
LIFF_ID_PAYSLIP=your_liff_id_for_payslip # endpoint: /liff/payslip
LIFF_ID_CHECKIN=your_liff_id_for_checkin # endpoint: /liff/checkin
LIFF_ID_HISTORY=your_liff_id_for_history # endpoint: /liff/history
LIFF_ID_PROFILE=your_liff_id_for_profile # endpoint: /liff/profile

# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Email Notification
# ============================================
# EMAIL_PROVIDER: gmail | outlook | smtp (default)
EMAIL_PROVIDER=gmail

# ชื่อผู้ส่งที่จะแสดงใน inbox
EMAIL_FROM_NAME=ต่อกัน HR

# Gmail: ใช้ App Password (ไม่ใช่รหัส Google ปกติ)
# สร้างที่: myaccount.google.com > Security > App passwords
EMAIL_USER=hr@togkun.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Outlook / Office 365
# EMAIL_USER=hr@togkun.com
# EMAIL_PASSWORD=your_password

# SMTP ทั่วไป
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_USER=hr@togkun.com
# EMAIL_PASSWORD=your_password

# ============================================
# GPS / Clock-In Office Location
# ============================================
# พิกัดออฟฟิศ — เปิด Google Maps คลิกขวา "What's here?" เพื่อดูพิกัด
OFFICE_LAT=13.7563
OFFICE_LNG=100.5018
# รัศมีอนุญาต (เมตร) — 200-500 เมตรแนะนำ
OFFICE_RADIUS_METERS=300

# ============================================
# Admin Dashboard (Optional)
# ============================================
ADMIN_SECRET_KEY=change_this_secret_key

# ============================================
# LIFF ID ของหน้าที่ไม่มีปุ่มใน Rich Menu
# ============================================
# Rich Menu มี 6 ช่องและเต็มแล้ว สองหน้านี้จึงเข้าผ่านการ "พิมพ์คำสั่ง" แทน
#   สลิปเงินเดือน → พิมพ์: สลิป / สลิปเงินเดือน / payslip
#   เบิกค่าใช้จ่าย → พิมพ์: เบิก / เบิกค่าใช้จ่าย / expense
# ถ้าเว้นว่าง ระบบจะตอบว่า "ยังไม่พร้อมใช้งาน" แทนที่จะส่งลิงก์เสีย
LIFF_ID_PAYSLIP=
LIFF_ID_EXPENSE=

# ============================================
# สวิตช์ส่งสลิปเงินเดือนจริง
# ============================================
# ค่าเริ่มต้น (เว้นว่าง) = โหมดทดสอบรูปแบบ
#   - กด "Mark as Paid" จะบันทึกสถานะอย่างเดียว ไม่ส่งสลิปให้พนักงาน
#   - ใช้ปุ่ม "ส่งตัวอย่างให้ Admin" ในหน้า Payroll เพื่อตรวจรูปแบบ
# ตั้งเป็น 1 เมื่อรูปแบบเรียบร้อยแล้วและพร้อมส่งจริง
# ❗ สลิปส่งเข้า LINE แล้วเรียกคืนไม่ได้ ตรวจตัวเลขให้ครบก่อนเปิด
PAYSLIP_LINE_ENABLED=

# ============================================
# ยืนยันตัวตนพนักงานในหน้า LIFF  (สำคัญด้านความปลอดภัย)
# ============================================
# Channel ID ของ "LINE Login channel" ที่ LIFF app ผูกอยู่
#   ดูที่: LINE Developers → LINE Login channel → Basic settings → Channel ID
#   ❗ ไม่ใช่ Channel ID ของ Messaging API — คนละตัวกัน
#   ❗ LIFF app ต้องเปิด scope "openid" ด้วย ไม่งั้น getIDToken() คืน null
LINE_LOGIN_CHANNEL_ID=

# เปิดโหมดบังคับยืนยันตัวตน — request ที่ไม่มี ID Token จะถูกปฏิเสธ
#   ปล่อยว่างไว้ตอน deploy รอบแรก แล้วดู log ว่าไม่มี warning
#   "[lineVerify] ⚠️ ... ไม่ได้ส่ง ID Token" เหลือแล้ว จึงตั้งเป็น 1
#   ถ้าตั้ง 1 ทันทีโดยที่ยังไม่ได้ตั้ง LINE_LOGIN_CHANNEL_ID
#   หรือ LIFF ยังไม่เปิด scope openid → พนักงานใช้งานไม่ได้ทั้งบริษัท
LIFF_REQUIRE_ID_TOKEN=
